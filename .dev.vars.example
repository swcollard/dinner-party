# Local secrets for `npm run dev` (copy to .dev.vars, which is git-ignored).
# Both must be at least 32 characters: `openssl rand -hex 32`.
# Lets the first person become organizer. Setup stays locked until it's long enough.
SETUP_SECRET=
# Signs every link. Changing it revokes all links.
LINK_SECRET=
PUBLIC_BASE_URL=http://localhost:8787
