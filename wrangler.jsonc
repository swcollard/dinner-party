{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinner-club",
  "main": "src/index.tsx",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./public" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinner-club-v1",
      "database_id": "d671766c-d18d-42b7-a804-2d1fe1ce5877",
      "migrations_dir": "migrations"
    }
  ],
  // /k and /i URLs carry tokens, so request logging stays off.
  "observability": { "enabled": false }
}
