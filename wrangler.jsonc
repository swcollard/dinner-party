{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Local-dev config only. The name is deliberately NOT "dinner-party": production uses that name, so a
  // bare `wrangler deploy` (no --env) must never be able to overwrite it. Deploy with --env staging|production.
  "name": "dinner-party-local-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // Logs + errors in the Cloudflare dashboard (Workers > Observability).
  "observability": { "enabled": true },

  // Static PWA shell. The Worker runs first only for API-ish paths; everything else is served from ./public.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/calendar/*", "/admin/*", "/healthz"]
  },

  // Top level = local development (`wrangler dev`). Deployed environments are below.
  // Bindings, vars and crons are NOT inherited by [env.*], so each one declares its own.
  "d1_databases": [
    { "binding": "DB", "database_name": "dinner-party-local", "database_id": "local", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "dinner-party-backups-local" }],
  // Every 15 minutes: reminders + closing past dinners (each group's reminder hour/timezone decides
  // what is due; frequent runs let a large batch drain within the per-run send budget).
  // Weekly Sunday 09:00 UTC: database backup to R2 (must equal BACKUP_CRON in src/backup.ts).
  "triggers": { "crons": ["*/15 * * * *", "0 9 * * 0"] },
  "vars": { "PUBLIC_BASE_URL": "http://localhost:8787" },

  // Secrets are per environment: wrangler secret put SETUP_SECRET --env <name>
  // (and RESEND_API_KEY, plus EMAIL_FROM as a var once a sending domain is verified).
  "env": {
    "staging": {
      "name": "dinner-party-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dinner-party-staging",
          // wrangler d1 create dinner-party-staging
          "database_id": "00000000-0000-0000-0000-000000000001",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "dinner-party-backups-staging" }],
      "triggers": { "crons": ["*/15 * * * *", "0 9 * * 0"] },
      "vars": { "PUBLIC_BASE_URL": "https://dinner-party-staging.example.workers.dev" }
    },
    "production": {
      "name": "dinner-party",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "dinner-party",
          // wrangler d1 create dinner-party
          "database_id": "00000000-0000-0000-0000-000000000002",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "dinner-party-backups" }],
      "triggers": { "crons": ["*/15 * * * *", "0 9 * * 0"] },
      // Replace with the custom domain once attached to the Worker.
      "vars": { "PUBLIC_BASE_URL": "https://dinner-party.example.com" }
    }
  }
}
