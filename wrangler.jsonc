{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dinner-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dinner-party",
      // Replace after running: wrangler d1 create dinner-party
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "BACKUPS", "bucket_name": "dinner-party-backups" }],
  // Hourly: reminders (each group's own reminder hour/timezone decides what is due).
  // Weekly Sunday 09:00 UTC: database backup to R2 (must equal BACKUP_CRON in src/backup.ts).
  "triggers": { "crons": ["0 * * * *", "0 9 * * 0"] },
  "vars": {
    "PUBLIC_BASE_URL": "http://localhost:8787"
  }
  // Secrets (wrangler secret put ...): SETUP_SECRET (later: RESEND_API_KEY)
  // Later: photos -> add a second R2 bucket binding (PHOTOS).
}
