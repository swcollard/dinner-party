{
  "name": "dinner-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Coordinate dinner party hosting with friends (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply dinner-party --local",
    "db:migrate:remote": "wrangler d1 migrations apply dinner-party --remote"
  },
  "dependencies": {
    "hono": "^4.13.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261117.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  }
}
